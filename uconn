        // Position above cursor for hover
        const padding = 10;
        left = scene.pointerX - (rect.width / 2);
        top = scene.pointerY - rect.height - padding;
      } else {
        // Center on screen for click
        left = (window.innerWidth - rect.width) / 2;
        top = (window.innerHeight - rect.height) / 2;
      }

      // Boundary checks
      if (left + rect.width > window.innerWidth) {
        left = window.innerWidth - rect.width - 10;
      }
      if (left < 10) {
        left = 10;
      }
      if (top < 10) {
        top = 10;
      }
      if (top + rect.height > window.innerHeight) {
        top = window.innerHeight - rect.height - 10;
      }

      element.style.left = `${left}px`;
      element.style.top = `${top}px`;
    }
  
      
    // Helper function to check if a custom mesh has any active interactions
    function hasInteractions(customMesh) {
      const interaction = customMesh.interaction;
      if (!interaction) {
        return false;
      }
      // Check if any interaction flag is true
      return !!(
        interaction.triggerUIPopup ||
        interaction.playAudio ||
        interaction.playModelAnimation ||
        interaction.triggerDirectLink
      );
    }

    // Helper function to apply opacity to a mesh and its children's materials (Enhanced for Export)
    function applyOpacityToMesh(mesh, opacity) {
      if (!mesh || (typeof mesh.isDisposed === 'function' && mesh.isDisposed())) return; // Safe disposed check

      const applyToMaterial = (material) => {
        if (!material) return; // Check only for null/undefined

        let needsMarkDirty = false;
        const PBRMATERIAL_ALPHABLEND = 2; // Define enum value locally
        const MATERIAL_TextureDirtyFlag = 4; // Define enum value locally
        const MATERIAL_AttributesDirtyFlag = 1; // Define enum value locally

        // --- Material Handling ---
        // Check if alpha property exists and differs
        if (material.alpha !== undefined && material.alpha !== opacity) {
          material.alpha = opacity;
          needsMarkDirty = true;
        }

        // --- Standard Material Specifics ---
        // Check if it looks like a StandardMaterial (has diffuseTexture)
        if (material.diffuseTexture !== undefined) {
            // Ensure useAlphaFromDiffuseTexture is true when transparent and texture exists
            if (opacity < 1 && material.diffuseTexture && !material.useAlphaFromDiffuseTexture) {
               material.useAlphaFromDiffuseTexture = true;
               needsMarkDirty = true;
            }
            // Ensure alpha is set (already handled above, but good to be explicit)
            if (material.alpha !== opacity) {
               material.alpha = opacity;
               needsMarkDirty = true;
            }
            // Optional: Reset useAlphaFromDiffuseTexture if opaque? Usually not necessary.
        }
        // --- PBR Material Specifics ---
        // Check if it looks like a PBR material (has transparencyMode)
        else if (material.transparencyMode !== undefined) {
          const targetTransparencyMode = opacity < 1 ? PBRMATERIAL_ALPHABLEND : null; // Use null for opaque

          if (material.transparencyMode !== targetTransparencyMode) {
            material.transparencyMode = targetTransparencyMode;
            needsMarkDirty = true;
          }

          // Ensure necessary flags for PBR transparency
          if (opacity < 1) {
            // If albedo texture exists, ensure it's used for alpha
            if (material.albedoTexture && !material.useAlphaFromAlbedoTexture) {
              material.useAlphaFromAlbedoTexture = true;
              needsMarkDirty = true;
            }
            // If no albedo texture, ensure alpha is used directly (optional reset)
          }
        }

        // Mark material as dirty if changes were made
        if (needsMarkDirty) {
           // Prefer markDirty if it exists
           if (typeof material.markDirty === 'function') {
               material.markDirty(true);
           }
           // Fallback for StandardMaterial-like dirty flags (Texture + Attributes)
           else if (typeof material.markAsDirty === 'function' && material.diffuseTexture !== undefined) {
               material.markAsDirty(MATERIAL_TextureDirtyFlag | MATERIAL_AttributesDirtyFlag);
           }
           // Consider adding fallbacks for other material types if needed
        }
      };

      // Apply to the mesh's own material
      applyToMaterial(mesh.material);

      // Apply to materials of child meshes recursively
        mesh.getChildMeshes(false, (node) => { 
          if (node instanceof BABYLON.AbstractMesh && !node.isDisposed()) { // Check node is valid mesh
            applyToMaterial(node.material);
          }
          return true; // Continue traversal
        });
    };

    // Initialize custom meshes (with fallback to empty array if undefined)
    const customMeshes = [];
    console.log('Initializing custom meshes:', customMeshes);
    
    // Track loaded meshes for visibility updates
    const loadedCustomMeshes = new Map();
    
    // Keep track of playing audio for custom meshes (legacy, might be removable later if not used elsewhere)
    const customMeshAudioSources = new Map();
    // Track the toggle state specifically for click-triggered audio
    const customMeshAudioPlayingState = new Map();
    
    // Animation registry to track which animation groups belong to which meshes
    const meshAnimationRegistry = new Map();
    
    // Helper function to display mesh content - reuses hotspot popup system
    function displayMeshContent(customMesh) {
      if (!customMesh.interaction) return;
      
      // Create a hotspot object to reuse the existing display system
      const hotspot = {
        id: `mesh-content-${customMesh.id}`,
        position: customMesh.position,
        scale: customMesh.scale,
        rotation: customMesh.rotation,
        title: customMesh.interaction.title || customMesh.name,
        information: customMesh.interaction.information,
        // Use the specific popupTriggerMode for the display logic
        activationMode: customMesh.interaction.popupTriggerMode || 'click', // Default to 'click' if undefined
        color: '#ffffff',
        type: 'sphere',
        contentType: customMesh.interaction.contentType,
        photoUrl: customMesh.interaction.photoUrl,
        iframeUrl: customMesh.interaction.iframeUrl,
        externalLinkUrl: customMesh.interaction.externalLinkUrl,
        externalLinkText: customMesh.interaction.externalLinkText,
        backgroundColor: customMesh.interaction.backgroundColor || '#000000',
        textColor: customMesh.interaction.textColor || '#ffffff',
        fontSize: customMesh.interaction.fontSize || 16,
        fontFamily: customMesh.interaction.fontFamily || 'inherit',
        externalLinkButtonColor: customMesh.interaction.externalLinkButtonColor || '#007bff',
        closeButtonColor: customMesh.interaction.closeButtonColor || '#4caf50',
      };
      
      // Set the hotspot to display using the hotspot system
      showHotspotContent(hotspot);
    }
    
    // Helper function to play audio for a mesh
    // isToggle parameter determines if this is a click (true) or hover (false) action
    async function playMeshAudio(customMesh, isToggle = false) {
      if (!customMesh.interaction || !customMesh.interaction.playAudio || !customMesh.interaction.audioUrl) return;
      
      const audioId = customMesh.interaction.audioId || `mesh-audio-${customMesh.id}`;
      const loadedMesh = loadedCustomMeshes.get(customMesh.id);
      
      // --- Click Toggle Logic ---
      if (isToggle) {
        const isCurrentlyPlayingViaClick = customMeshAudioPlayingState.get(audioId);
        if (isCurrentlyPlayingViaClick) {
          console.log(`[Click Toggle] Stopping audio for mesh ${customMesh.id}`);
          audioManager.stopSound(audioId);
          customMeshAudioPlayingState.set(audioId, false); // Update click toggle state
          return; // Stop execution after stopping
        } else {
          // If not currently playing via click, proceed to play and set state
          console.log(`[Click Toggle] Starting audio for mesh ${customMesh.id}`);
          // Fall through to the playback logic below
        }
      }
      // --- Hover Logic (or initial click play) ---
      else {
        // If it's a hover action, check if *any* sound (hover or click) is already playing
        if (audioManager.isSoundPlaying(audioId)) {
          console.log(`[Hover] Audio already playing for mesh ${customMesh.id}, doing nothing.`);
          return; // Don't start a new sound if one is already active
        }
        console.log(`[Hover] Starting audio for mesh ${customMesh.id}`);
        // Fall through to the playback logic below
      }
      
      // --- Common Playback Logic ---
      // Prepare audio data
      const audioData = {
        id: audioId,
        url: customMesh.interaction.audioUrl,
        spatialSound: customMesh.interaction.audioSpatial ?? false,
        volume: customMesh.interaction.audioVolume ?? 1,
        loop: customMesh.interaction.audioLoop ?? false,
        distanceModel: customMesh.interaction.audioDistanceModel || 'exponential',
        maxDistance: customMesh.interaction.audioMaxDistance ?? 100,
        refDistance: customMesh.interaction.audioRefDistance ?? 1, // This is the Distance" in the UI
        rolloffFactor: customMesh.interaction.audioRolloffFactor ?? 1
      };
      
      // Get position for spatial audio
      let position;
      if (loadedMesh && loadedMesh.transformNode) {
        position = new BABYLON.Vector3(
          loadedMesh.transformNode.position.x,
          loadedMesh.transformNode.position.y,
          loadedMesh.transformNode.position.z
        );
      }
      
      // Play the sound using the shared audio manager
      audioManager.playSound(audioData, { scene, position });
      
      // If this was a click toggle action, update the state map
      if (isToggle) {
        customMeshAudioPlayingState.set(audioId, true);
      }
      console.log(`Audio action processed for mesh ${customMesh.id} (Toggle: ${isToggle})`);
    }
    
    // Helper function to stop audio for a mesh (primarily used on hover out)
    function stopMeshAudio(customMesh) {
      if (!customMesh.interaction || !customMesh.interaction.playAudio) return;
      
      const audioId = customMesh.interaction.audioId || `mesh-audio-${customMesh.id}`;
      
      // Only stop if it's actually playing (prevents unnecessary calls)
      if (audioManager.isSoundPlaying(audioId)) {
        console.log(`[Hover Out] Stopping audio for mesh ${customMesh.id}`);
        audioManager.stopSound(audioId);
      }
      
      // Also, reset the click toggle state if it was active.
      // This handles the case where user clicks play, then hovers out.
      if (customMeshAudioPlayingState.get(audioId)) {
        console.log(`[Hover Out] Resetting click toggle state for mesh ${customMesh.id}`);
        customMeshAudioPlayingState.set(audioId, false);
      }
    }

    // Helper function to find animation groups for a mesh with more comprehensive search
    function findMeshAnimationGroups(customMesh) {
      const loadedMesh = loadedCustomMeshes.get(customMesh.id);
      if (!loadedMesh) return [];
      
      // First check if we already have registered animations for this mesh
      if (meshAnimationRegistry.has(customMesh.id)) {
        return meshAnimationRegistry.get(customMesh.id) || [];
      }
      
      // More comprehensive search for animation groups
      const meshAnimationGroups = scene.animationGroups.filter(group => {
        // Check if any animation targets the mesh, its parent, or any of its children
        return group.targetedAnimations.some(anim => {
          const target = anim.target;
          
          // Check if target is the mesh itself
          if (target === loadedMesh.mesh) return true;
          
          // Check if target is the mesh's parent (transform node)
          if (target === loadedMesh.transformNode) return true;
          
          // Check if target is a child of the mesh
          if (loadedMesh.mesh.getChildMeshes && loadedMesh.mesh.getChildMeshes().some(child => child === target)) return true;
          
          // Check by name (sometimes targets are referenced by name)
          if (target.name && loadedMesh.mesh.name && (
            target.name.includes(loadedMesh.mesh.name) || 
            loadedMesh.mesh.name.includes(target.name)
          )) return true;
          
          return false;
        });
      });
      
      // Store the found animation groups in the registry for future use
      if (meshAnimationGroups.length > 0) {
        meshAnimationRegistry.set(customMesh.id, meshAnimationGroups);
        console.log(`Registered ${meshAnimationGroups.length} animation groups for mesh ${customMesh.id}`);
      } else {
        console.log(`No animation groups found for mesh ${customMesh.id}`);
      }
      
      return meshAnimationGroups;
    }

    // Helper function to play/resume animations for a mesh (used on hover in)
    function playMeshAnimations(customMesh) {
      if (!customMesh.interaction || !customMesh.interaction.playModelAnimation) return;
      
      const meshAnimationGroups = findMeshAnimationGroups(customMesh);
      
      meshAnimationGroups.forEach(group => {
        if (!group.isPlaying) {
          console.log(`Playing animation for mesh ${customMesh.id} on hover`);
          // Default loop to true if not specified
          group.play(customMesh.interaction.animationLoop ?? true); 
        }
      });
    }

    // Helper function to pause animations for a mesh (used on hover out)
    function pauseMeshAnimations(customMesh) {
      if (!customMesh.interaction || !customMesh.interaction.playModelAnimation) return;
      
      const meshAnimationGroups = findMeshAnimationGroups(customMesh);
      
      meshAnimationGroups.forEach(group => {
        if (group.isPlaying) {
          console.log(`Pausing animation for mesh ${customMesh.id} on hover out`);
          group.pause();
        }
      });
    }
    
    // Helper function to toggle animations for a mesh (used on click)
    function toggleMeshAnimations(customMesh) {
      if (!customMesh.interaction || !customMesh.interaction.playModelAnimation) return;
      
      const meshAnimationGroups = findMeshAnimationGroups(customMesh);
      console.log(`Found ${meshAnimationGroups.length} animation groups for mesh ${customMesh.id}`);
      
      if (meshAnimationGroups.length === 0) {
        console.warn(`No animations found to toggle for mesh ${customMesh.id}`);
        return;
      }
      
      // Toggle play/pause for each animation group
      meshAnimationGroups.forEach(group => {
        if (group.isPlaying) {
          console.log(`Pausing animation for mesh ${customMesh.id} on click`);
          group.pause();
        } else {
          console.log(`Playing animation for mesh ${customMesh.id} on click`);
          // Default loop to true if not specified
          group.play(customMesh.interaction.animationLoop ?? true); 
        }
      });
    }

    // Handle direct link for a mesh
    function handleDirectLink(customMesh) {
      if (!customMesh.interaction || !customMesh.interaction.triggerDirectLink || !customMesh.interaction.directLinkUrl) return;
      window.open(customMesh.interaction.directLinkUrl, '_blank');
    }
    
      // Setup interaction handlers for a mesh
      function setupMeshInteractions(mesh, customMesh) {
        // Early return if no interactions are defined OR if the helper function says none are active
        if (!customMesh.interaction || !hasInteractions(customMesh)) {
          console.log(`Skipping interaction setup for ${customMesh.name} as it has no active interaction flags.`);
          return;
        }
        
        // Apply interaction handlers to this mesh and all its children
        const applyInteractionToMesh = (targetMesh) => {
          // Dispose existing action manager if it exists
          if (targetMesh.actionManager) {
            targetMesh.actionManager.dispose();
          }
          
          // Create a new action manager
          targetMesh.actionManager = new BABYLON.ActionManager(scene);
        
        // Safely access the activation mode with fallback to 'click'
        const activationMode = customMesh.interaction?.activationMode || 'click';
        
        // Handle hover
        if (activationMode === 'hover' || activationMode === 'click') {
          targetMesh.actionManager.registerAction(
            new BABYLON.ExecuteCodeAction(
              BABYLON.ActionManager.OnPointerOverTrigger,
              () => {
                // Highlight mesh on hover
                const material = targetMesh.material;
                if (material) {
                  material.emissiveColor = new BABYLON.Color3(0.2, 0.2, 0.2);
                }
                
                // For each interaction type, check if it should trigger on hover
                // UI Popup - trigger on hover if specifically set or if activationMode is hover
                const popupTriggerMode = customMesh.interaction?.popupTriggerMode || activationMode;
                if (popupTriggerMode === 'hover' && customMesh.interaction?.triggerUIPopup) {
                  displayMeshContent(customMesh);
                }
                
                // Audio - trigger on hover if specifically set or if activationMode is hover
                const audioTriggerMode = customMesh.interaction?.audioTriggerMode || activationMode;
                if (audioTriggerMode === 'hover' && customMesh.interaction?.playAudio) {
                  playMeshAudio(customMesh, false); // Explicitly false for hover
                }
                
                // Animation - trigger on hover if specifically set or if activationMode is hover
                const animationTriggerMode = customMesh.interaction?.animationTriggerMode || activationMode;
                if (animationTriggerMode === 'hover' && customMesh.interaction?.playModelAnimation) {
                  playMeshAnimations(customMesh);
                }
                
                // Direct link - trigger on hover if specifically set or if activationMode is hover
                const directLinkTriggerMode = customMesh.interaction?.directLinkTriggerMode || activationMode;
                if (directLinkTriggerMode === 'hover' && customMesh.interaction?.triggerDirectLink) {
                  handleDirectLink(customMesh);
                }
              }
            )
          );
          
          targetMesh.actionManager.registerAction(
            new BABYLON.ExecuteCodeAction(
              BABYLON.ActionManager.OnPointerOutTrigger,
              () => {
                // Reset highlight
                const material = targetMesh.material;
                if (material) {
                  material.emissiveColor = new BABYLON.Color3(0, 0, 0);
                }

                // Handle hover-out interactions by checking specific trigger modes
                const popupTriggerModeOut = customMesh.interaction?.popupTriggerMode || activationMode;
                if (popupTriggerModeOut === 'hover' && customMesh.interaction?.triggerUIPopup) {
                  hideHotspotContent(); // Hide the popup
                }

                const audioTriggerModeOut = customMesh.interaction?.audioTriggerMode || activationMode;
                if (audioTriggerModeOut === 'hover' && customMesh.interaction?.playAudio) {
                  stopMeshAudio(customMesh); // Use specific stop function
                }

                const animationTriggerModeOut = customMesh.interaction?.animationTriggerMode || activationMode;
                if (animationTriggerModeOut === 'hover' && customMesh.interaction?.playModelAnimation) {
                  pauseMeshAnimations(customMesh); // Use specific pause function
                }
                // Direct link usually not reversed on hover out
              }
            )
          );
        }
        
        // Handle click
        if (activationMode === 'click') {
          targetMesh.actionManager.registerAction(
            new BABYLON.ExecuteCodeAction(
              BABYLON.ActionManager.OnPickTrigger,
              () => {
                console.log(`Clicked on mesh ${customMesh.name}`);
                
                // For each interaction type, check if it should trigger on click
                // UI Popup - trigger on click if specifically set or if activationMode is click
                const popupTriggerMode = customMesh.interaction?.popupTriggerMode || activationMode;
                if (popupTriggerMode === 'click' && customMesh.interaction?.triggerUIPopup) {
                  displayMeshContent(customMesh);
                }
                
                // Animation - trigger on click if specifically set or if activationMode is click
                const animationTriggerMode = customMesh.interaction?.animationTriggerMode || activationMode;
                if (animationTriggerMode === 'click' && customMesh.interaction?.playModelAnimation) {
                  toggleMeshAnimations(customMesh);
                }
                
                // Audio - trigger on click if specifically set or if activationMode is click
                const audioTriggerMode = customMesh.interaction?.audioTriggerMode || activationMode;
                if (audioTriggerMode === 'click' && customMesh.interaction?.playAudio) {
                  playMeshAudio(customMesh, true); // Pass true for toggle behavior on click
                }
                
                // Direct link - trigger on click if specifically set or if activationMode is click
                const directLinkTriggerMode = customMesh.interaction?.directLinkTriggerMode || activationMode;
                if (directLinkTriggerMode === 'click' && customMesh.interaction?.triggerDirectLink) {
                  handleDirectLink(customMesh);
                }
              }
            )
          );
        }
      };
      
      // Apply interactions to the root mesh
      applyInteractionToMesh(mesh);
      
      // Recursively apply interactions to all child meshes
      mesh.getChildMeshes().forEach(childMesh => {
        applyInteractionToMesh(childMesh);
      });
    }

    // Load all custom meshes
    async function loadCustomMeshes() {
      if (!customMeshes || customMeshes.length === 0) {
        console.log('No custom meshes to load');
        return;
      }

      console.log('Loading custom meshes:', customMeshes);
      
      for (const customMesh of customMeshes) {
        try {
          // Create a transform node for the mesh
          const transformNodeName = `custom-mesh-transform-${customMesh.id}`;
          const transformNode = new BABYLON.TransformNode(transformNodeName, scene);
          
          // Set position and rotation
          transformNode.position = new BABYLON.Vector3(
            customMesh.position._x || customMesh.position.x,
            customMesh.position._y || customMesh.position.y,
            customMesh.position._z || customMesh.position.z
          );
          
          transformNode.rotation = new BABYLON.Vector3(
            customMesh.rotation._x || customMesh.rotation.x,
            customMesh.rotation._y || customMesh.rotation.y,
            customMesh.rotation._z || customMesh.rotation.z
          );
          
          // Load the mesh
          console.log(`Loading custom mesh from URL: ${customMesh.modelUrl}`);
          const meshContainer = await BABYLON.SceneLoader.ImportMeshAsync(
            "",
            customMesh.modelUrl,
            "",
            scene
          );
          
          if (meshContainer.meshes.length > 0) {
            // Get the root mesh
            const rootMesh = meshContainer.meshes[0];
            rootMesh.name = `custom-mesh-${customMesh.id}`;
            
            // Parent to transform node
            rootMesh.parent = transformNode;
            
            // Apply scale
            rootMesh.scaling = new BABYLON.Vector3(
              customMesh.scale._x || customMesh.scale.x,
              customMesh.scale._y || customMesh.scale.y,
              customMesh.scale._z || customMesh.scale.z
            );
            
            // Set initial visibility
            const isInitiallyVisible = customMesh.enabled;
            rootMesh.setEnabled(isInitiallyVisible);
            transformNode.setEnabled(isInitiallyVisible);

            // Apply initial static opacity
            if (customMesh.opacityMode === 'static') {
              applyOpacityToMesh(rootMesh, customMesh.opacity ?? 1);
            } else {
              applyOpacityToMesh(rootMesh, 1); // Default to opaque
            }

            // Determine if the mesh has interactions
            const isInteractive = hasInteractions(customMesh);

            // Set pickable status based on interactivity
            const setPickableRecursively = (node, pickable) => {
              if (node instanceof BABYLON.AbstractMesh) {
                node.isPickable = pickable;
              }
              // Check if getChildren exists before calling it
              if (typeof node.getChildren === 'function') {
                node.getChildren().forEach(child => setPickableRecursively(child, pickable));
              }
            };
            setPickableRecursively(rootMesh, isInteractive);
            console.log(`Mesh ${customMesh.name} isPickable set to: ${isInteractive}`);

            // Set up interaction handlers ONLY if needed
            if (isInteractive) {
              console.log('Setting up interactions for mesh:', customMesh.name);
              setupMeshInteractions(rootMesh, customMesh);
            } else {
              console.log('Skipping interaction setup for non-interactive mesh:', customMesh.name);
            }
            
            // Handle animations if present (animations can play even if not interactive via click/hover)
            if (meshContainer.animationGroups && meshContainer.animationGroups.length > 0) {
              // Register animations with the mesh in our registry
              meshAnimationRegistry.set(customMesh.id, meshContainer.animationGroups);
              console.log(`Registered ${meshContainer.animationGroups.length} animation groups for mesh ${customMesh.id} during load`);
              
              // Stop all animations initially, will be controlled by interaction
              meshContainer.animationGroups.forEach(animationGroup => {
                animationGroup.stop();
                
                // If autoplay is enabled, start the animation
                if (customMesh.interaction?.animationAutoPlay) {
                  console.log(`Autoplaying animation for mesh: ${customMesh.name}`);
                  animationGroup.play(true); // Start looping animation
                }
              });
            }
            
            // Store in loaded meshes map
            loadedCustomMeshes.set(customMesh.id, {
              mesh: rootMesh,
              transformNode: transformNode
            });
            
            console.log(`Successfully loaded custom mesh: ${customMesh.name}`);
          }
        } catch (error) {
          console.error(`Error loading custom mesh ${customMesh.name}:`, error);
        }
      }
    }
    
    // Cleanup function for custom meshes
    function cleanupCustomMeshes() {
      // Stop all audio for custom meshes
      customMeshes.forEach(mesh => {
        if (mesh.interaction && mesh.interaction.playAudio) {
          const audioId = mesh.interaction.audioId || `mesh-audio-${mesh.id}`;
          audioManager.stopSound(audioId);
        }
      });
      
      // Clear animation registry
      meshAnimationRegistry.clear();
    }
    
    // Register scene before render to update custom mesh visibility
    scene.registerBeforeRender(() => {
      // Calculate current percentage and waypoint index
      const subdivisionsPerSegment = 20;
      let currentWaypointIndex = Math.round((scrollPosition / subdivisionsPerSegment) * 100) / 100; // Round to 2 decimal places for precision

      const scrollPercent = (scrollPosition / (path.length - 1 || 1)) * 100;
      
      // Update custom mesh visibility - check if customMeshes exists first
      if (customMeshes && customMeshes.length > 0) {
        customMeshes.forEach((mesh) => {
        const loadedMesh = loadedCustomMeshes.get(mesh.id);
        if (loadedMesh) {
          let isVisible = mesh.enabled;
          
          if (mesh.visibilityRange) {
            const { type, start, end } = mesh.visibilityRange;
            
            if (type === 'percentage') {
              isVisible = isVisible && (scrollPercent >= start && scrollPercent <= end);
            } else if (type === 'waypoint') {
              isVisible = isVisible && (currentWaypointIndex >= start && currentWaypointIndex <= end);
            }
          }
          
          loadedMesh.mesh.setEnabled(isVisible);
          loadedMesh.transformNode.setEnabled(isVisible);

          // Apply opacity if animated
          if (mesh.opacityMode === 'animated' && mesh.opacityAnimation) {
            const { startPercent, endPercent, startOpacity, endOpacity } = mesh.opacityAnimation;
            const animationRange = endPercent - startPercent;
            const currentRange = scrollPercent - startPercent;
            const currentOpacity = startOpacity + ((endOpacity - startOpacity) * (currentRange / animationRange));
            applyOpacityToMesh(loadedMesh.mesh, currentOpacity);
          }
        }
        });
      }
    });
    
    // When exiting fullscreen or closing experience
    window.addEventListener('beforeunload', () => {
      cleanupCustomMeshes();
    });
    
    // Initialize custom meshes
    loadCustomMeshes();
  
      
    // Create control points and rotations from waypoints
    const controlPoints = waypoints.map(
      (wp) => new BABYLON.Vector3(wp.x, wp.y, wp.z)
    );
    const rotations = waypoints.map(
      (wp) => new BABYLON.Quaternion(wp.rotation._x, wp.rotation._y, wp.rotation._z, wp.rotation._w).normalize()
    );

    // Generate path from control points
    let path = [];
    if (controlPoints.length >= 2) {
      const positionCurve = BABYLON.Curve3.CreateCatmullRomSpline(
        controlPoints,
        20,
        false
      );
      path = positionCurve.getPoints();
    } else if (controlPoints.length === 1) {
      path = [controlPoints[0]];
    }

    function changeCameraMode(selectedMode) {
      if (["tour","explore","hybrid","edit"].includes(selectedMode)) {

        if (selectedMode != 'walk') {
          disableWalkMode();
                }

        cameraMode = selectedMode;
        userControl = cameraMode === 'explore' || cameraMode === 'walk';

        trackCameraMode(selectedMode);

        if (BABYLON.VirtualJoystick.Canvas) {
          BABYLON.VirtualJoystick.Canvas.style.zIndex =
            cameraMode === 'tour' ? '-10' : '10';
        }

        updateScrollControlsVisibility();
        updateModeToggleUI();
      }
    }
    // Assign the core function to the window object
    window.changeCameraMode = changeCameraMode;

    function updateScrollControlsVisibility() {
      const scrollControlsContent = document.getElementById('scrollControlsContent');
      if (scrollControlsContent) {
        if (cameraMode === 'explore' || cameraMode === 'walk') {
          scrollControlsContent.classList.add('hidden');
        } else {
          scrollControlsContent.classList.remove('hidden');
        }
      }
    }

    function updateModeToggleUI() {
      const modes = ['explore', 'tour', 'hybrid', 'walk'];
      modes.forEach(function(mode) {
        const button = document.getElementById('mode' + capitalizeFirstLetter(mode));
        if (button) {
          if (cameraMode === mode) {
            button.classList.add('selected');
          } else {
            button.classList.remove('selected');
          }
        }
      });
    }

    function capitalizeFirstLetter(string) {
      return string.charAt(0).toUpperCase() + string.slice(1);
    }

    function showWaypointInfo(waypoint) {
      const waypointInfo = document.getElementById('waypointInfo');

      if (waypointInfo) {
        waypointInfo.innerHTML = '';
        waypointInfo.classList.remove('hasContent');

        let hasContent = false;

        if (waypoint.name) {
          const nameElement = document.createElement('h3');
          nameElement.style.fontWeight = 'bold';
          nameElement.style.margin = '0 0 8px 0';
          nameElement.style.textAlign = 'center';
          nameElement.style.marginTop = '10px';
          nameElement.textContent = waypoint.name;
          waypointInfo.appendChild(nameElement);
          hasContent = true;
        }

        const infoInteraction = waypoint.interactions.find(
          (interaction) => interaction.type === 'info'
        );

        if (
          infoInteraction &&
          infoInteraction.data &&
          infoInteraction.data.text &&
          'controls' === 'controls'
        ) {
          const descElement = document.createElement('p');
          descElement.style.textAlign = 'center';
          descElement.textContent = infoInteraction.data.text;
          waypointInfo.appendChild(descElement);
          hasContent = true;
        }

        if (hasContent) {
          waypointInfo.classList.add('hasContent');
        }
        waypointInfo.style.display = 'block';
      }
    }

    function updateActiveWaypoint() {
      let closestWaypoint = null;
      let minDistance = Infinity;

      waypoints.forEach((wp, index) => {
        const distance = BABYLON.Vector3.Distance(
          camera.position,
          new BABYLON.Vector3(wp.x, wp.y, wp.z)
        );

        if (distance < minDistance) {
          minDistance = distance;
          closestWaypoint = wp;
        }

        const triggerDistance = wp.triggerDistance ?? 1.0;
        if (distance <= triggerDistance) {
          if (!activeWaypoints.has(index)) {
            activeWaypoints.add(index);
            trackWaypointReached(wp.name || `Waypoint ${index + 1}`, index);
            executeInteractions(wp.interactions, index);
          }
        } else {
          if (activeWaypoints.has(index)) {
            activeWaypoints.delete(index);
            reverseInteractions(wp.interactions);
          }
        }
      });

      if (closestWaypoint) {
        showWaypointInfo(closestWaypoint);
      }
    }

    function handleButtonScroll(direction) {
      if (cameraMode === 'explore' || cameraMode === 'walk') {
        return;
      }
      if ('waypoint' === 'percentage') {
        adjustScroll(direction * 10 / 100);
      } else {
        moveToWaypoint(direction);
      }
    }
    window.handleButtonScroll = handleButtonScroll;

    // Add event listeners programmatically
    const prevButton = document.getElementById('prevButton');
    const nextButton = document.getElementById('nextButton');
    if (prevButton) {
      prevButton.addEventListener('click', () => handleButtonScroll(-1));
    }
    if (nextButton) {
      nextButton.addEventListener('click', () => handleButtonScroll(1));
    }

    function adjustScroll(amount) {
      if(!scrollPaused){
        const pathLength = path.length;
        if (pathLength > 1) {
          const scrollIncrement = (pathLength - 1) * amount;
          scrollTarget += scrollIncrement;

          if (scrollTarget < 0) scrollTarget = 0;
