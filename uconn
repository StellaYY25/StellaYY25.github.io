// Shared AudioManager for exported HTML using Audio Engine v2
class AudioManager {
  isMuted;
  activeSounds;
  initialized;
  audioEngine;
  initializationPromise;

  constructor() {
    this.isMuted = false;
    this.activeSounds = new Map();
    this.initialized = false;
    this.audioEngine = null;
    this.initializationPromise = null;
  }

  // Initialize audio engine v2 after user interaction
  async initialize() {
    if (this.initialized) return true;
    
    if (this.initializationPromise) {
      return this.initializationPromise;
    }
    
    this.initializationPromise = new Promise(async (resolve) => {
      try {
        console.log("Initializing audio engine v2");
        this.audioEngine = await BABYLON.CreateAudioEngineAsync();
        
        // Try to unlock the audio context (needed for some browsers)
        try {
          if (this.audioEngine && typeof this.audioEngine.unlockAsync === 'function') {
            await this.audioEngine.unlockAsync();
          } else if (this.audioEngine && typeof (this.audioEngine).unlock === 'function') {
            await (this.audioEngine).unlock();
          }
        } catch (unlockError) {
          console.warn("Could not unlock audio engine", unlockError);
          // Continue even if unlock fails
        }
        
        console.log("Audio engine v2 initialized successfully");
        this.initialized = true;
        resolve(true);
      } catch (error) {
        console.error("Failed to initialize audio engine v2", error);
        this.initialized = false;
        resolve(false);
      }
    });
    
    return this.initializationPromise;
  }

  // Initialize after user interaction
  async initializeAfterUserInteraction() {
    return this.initialize();
  }

  async playSound(audioData, options = {}) {
    if (!audioData) {
      console.error("AudioManager: Cannot play sound - audioData is null or undefined");
      return;
    }

    if (!audioData.id) {
      // Extract a unique identifier from the URL if possible
      const urlParts = audioData.url?.split('/') || [];
      const lastPart = urlParts[urlParts.length - 1] || '';
      const idFromUrl = lastPart.split('?')[0] || `sound-${Date.now()}`;
      console.warn(`AudioManager: Sound ID is undefined, generating ID from URL: ${idFromUrl}`);
      audioData.id = idFromUrl;
    }

    if (typeof this.isMuted === 'undefined') {
      this.isMuted = false;
    }

    if (this.isMuted) return;

    // Initialize audio engine if not already initialized
    if (!this.initialized) {
      const success = await this.initialize();
      if (!success) {
        console.log("Audio engine initialization failed, waiting for user interaction");
        return;
      }
    }

    const { 
      scene, 
      position,
      waypointIndex 
    } = options;

    const id = audioData.id;
    const url = audioData.url;

    // Always stop and dispose any existing sound with the same ID
    const existingSound = this.activeSounds.get(id);
    if (existingSound) {
      console.log(`Stopping and disposing previous instance of sound ${id}`);
      existingSound.stop();
      existingSound.dispose();
      this.activeSounds.delete(id);
    }

    try {
      // Create a main bus if needed
      let mainBus = this.audioEngine.defaultMainBus;
      if (!mainBus) {
        mainBus = await this.audioEngine.createMainBusAsync("defaultMainBus");
      }
      
      // Create the sound using the appropriate method
      const sound = await this.audioEngine.createStreamingSoundAsync(
        id,
        url,
        {
          loop: audioData.loop !== undefined ? audioData.loop : true,
          volume: audioData.volume !== undefined ? audioData.volume : 1,
          autoplay: true,
          outBus: mainBus
        }
      );
      
      // Set up spatial audio if needed
      if (audioData.spatialSound && position) {
        // Ensure distanceModel is a valid string or default to 'exponential'
        const distanceModelString = ['linear', 'inverse', 'exponential'].includes(audioData.distanceModel || '') 
                                    ? audioData.distanceModel 
                                    : 'exponential';
        
        // Create a spatial audio node
        const spatialOptions = {
          distanceModel: distanceModelString,
          maxDistance: audioData.maxDistance || 100,
          refDistance: audioData.refDistance || 1,
          rolloffFactor: audioData.rolloffFactor || 1,
          position: position
        };
        
        // Apply spatial settings to the sound
        sound.spatial.position = new BABYLON.Vector3(position.x, position.y, position.z);
        sound.spatial.distanceModel = spatialOptions.distanceModel;
        sound.spatial.maxDistance = spatialOptions.maxDistance;
        sound.spatial.minDistance = spatialOptions.refDistance;
        sound.spatial.rolloffFactor = spatialOptions.rolloffFactor;
      }
      
      // Store metadata
      sound.metadata = {
        stopOnExit: audioData.stopOnExit,
        spatialSound: audioData.spatialSound
      };
      
       // Store the sound in active sounds
       this.activeSounds.set(id, sound);
       
       // Add an observer to remove the sound from activeSounds when it ends naturally
       sound.onEndedObservable.addOnce(() => {
         console.log(`AudioManager (Export): Sound ${id} ended naturally. Removing from active sounds.`);
         // Check if it still exists before deleting, in case it was stopped manually
         if (this.activeSounds.has(id)) {
           this.activeSounds.delete(id);
         }
       });

       // Track audio start if tracking function exists
       if (typeof trackAudioInteraction === 'function') {
         trackAudioInteraction(id, 'play');
       }
       
     } catch (error) {
       console.error(`Failed to create sound ${id}:`, error);
    }
  }

  stopSound(id) {
    const sound = this.activeSounds.get(id);
    if (sound) {
      sound.stop();
      sound.dispose();
      this.activeSounds.delete(id);
      // Track audio stop if tracking function exists
      if (typeof trackAudioInteraction === 'function') {
        trackAudioInteraction(id, 'stop');
      }
    }
  }

  stopAllSounds() {
    this.activeSounds.forEach((sound, id) => {
      sound.stop();
      sound.dispose();
      // Track each audio stop if tracking function exists
      if (typeof trackAudioInteraction === 'function') {
        trackAudioInteraction(id, 'stop');
      }
    });
    this.activeSounds.clear();
  }

  isSoundPlaying(id) {
    const sound = this.activeSounds.get(id);
    if (!sound) return false;
    
    // Check if sound is playing based on state property
    return sound.state === 'playing';
  }

  mute() {
    this.isMuted = true;
    
    // Set the audio engine volume to 0 if it exists
    if (this.audioEngine) {
      this.audioEngine.volume = 0;
    }
    
    this.activeSounds.forEach((sound, id) => {
      sound.stop();
      // Track audio mute if tracking function exists
      if (typeof trackAudioInteraction === 'function') {
        trackAudioInteraction(id, 'mute');
      }
    });
  }

  unmute() {
    this.isMuted = false;
    
    // Restore the audio engine volume if it exists
    if (this.audioEngine) {
      this.audioEngine.volume = 1;
    }
    
    // We don't automatically resume sounds when unmuting with the new API
    // Instead, we'll let new sounds play when triggered
    this.activeSounds.forEach((sound, id) => {
      // Track audio unmute if tracking function exists
      if (typeof trackAudioInteraction === 'function') {
        trackAudioInteraction(id, 'unmute');
      }
    });
  }
  
  // Getter for the spatial audio listener
  get listener() {
    if (this.audioEngine && this.audioEngine.listener) {
      return this.audioEngine.listener;
    }
    //console.warn("AudioManager (Export): Audio engine or listener not available.");
    return undefined;
  }
}

