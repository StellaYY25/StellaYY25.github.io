          const transformNode = mesh.parent; // Assuming parent is the transform node
          if (!transformNode) return;

          // --- Proximity Check ---
          if (h.mediaTriggerMode === 'proximity') {
            const distance = BABYLON.Vector3.Distance(activeCamera.globalPosition, transformNode.absolutePosition);
            const isInProximity = distance <= (h.proximityDistance ?? 5);
            const wasInProximity = hotspotMediaProximityState[h.id] ?? false;

            if (isInProximity && !wasInProximity) {
              if (h.type === 'video') {
