              sound.spatialSound = true;
              sound.distanceModel = hotspot.audioDistanceModel; // Defaulted
              sound.refDistance = hotspot.audioRefDistance;     // Defaulted
              sound.maxDistance = hotspot.audioMaxDistance;   // Defaulted
              sound.rolloffFactor = hotspot.audioRolloffFactor; // Defaulted
              
              // Need the mesh associated with this hotspot
              const meshForAudio = scene.getMeshByName(`hotspot-${hotspot.id}`);
              if (meshForAudio) {
                  sound.attachToMesh(meshForAudio);
              } else {
                  console.warn(`Could not find mesh for hotspot ${hotspot.id} to attach spatial audio.`);
              }
          } else {
              sound.spatialSound = false;
          }
          currentHotspotSound = sound;
      }
      // --- End New Audio Playback Logic ---

      // Only position if not fullscreen
      if (hotspot.activationMode !== 'click' || (!hotspot.photoUrl && hotspot.contentType !== 'iframe')) {
        positionHotspotContent(hotspotContent, hotspot);
      }
    }

    function hideHotspotContent() {
