        ${photoHtml}
        ${infoHtml}
        ${linkHtml}
        ${closeButtonHtml}
      `;

      hotspotContent.style.display = 'flex';

      // --- New Audio Playback Logic ---
      if (currentHotspotSound) {
          currentHotspotSound.stop();
          currentHotspotSound.dispose();
          currentHotspotSound = null;
      }

      // The 'hotspot' variable here comes from the 'hotspots' array which was populated from serializedHotspots.
      // These properties (e.g., hotspot.audioUrl) would have been defaulted by safeGet during serialization.
      if (hotspot.audioUrl && (hotspot.type === 'image' || hotspot.type === 'gif' || hotspot.type === 'sphere')) {
          const sound = new BABYLON.Sound(
              `hotspot-audio-${hotspot.id}`,
              hotspot.audioUrl,
              scene, // scene should be available in this scope
              () => { // onLoad
                  // Sound loaded, play it
                  sound.play();
              },
              { // options
                  loop: hotspot.audioLoop, // Defaulted during serialization
                  autoplay: false, // We will play it manually after load
