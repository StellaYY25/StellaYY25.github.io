    });
    // --- End User Interaction Detection ---


    function setupHotspotBehavior(mesh, h) {
      mesh.actionManager = new BABYLON.ActionManager(scene);

      // Only set up interactions if activation mode is not 'none'
      if (h.activationMode !== 'none') {
        mesh.actionManager.registerAction(
          new BABYLON.ExecuteCodeAction(
            BABYLON.ActionManager.OnPointerOverTrigger,
            () => {
              // console.log('Hotspot hover:', h.title); // Can be noisy
              if (h.type === 'sphere') { // Only apply emissive to spheres
                const mat = mesh.material;
                if (mat instanceof BABYLON.StandardMaterial) {
                   mat.emissiveColor = BABYLON.Color3.FromHexString(h.color);
                }
              }
              if (h.activationMode === 'hover' && !isInAR) {
                // trackHotspotInteraction(h.title, 'hover'); // Consider if needed
                showHotspotContent(h);
              }
            }
          )
        );

        mesh.actionManager.registerAction(
          new BABYLON.ExecuteCodeAction(
            BABYLON.ActionManager.OnPointerOutTrigger,
            () => {
              if (h.type === 'sphere') { // Only apply emissive to spheres
                 const mat = mesh.material;
                 if (mat instanceof BABYLON.StandardMaterial) {
                    mat.emissiveColor = BABYLON.Color3.FromHexString(h.color).scale(0.5);
                 }
              }
              if (h.activationMode === 'hover' && !isInAR) {
                hideHotspotContent();
              }
            }
          )
        );

        mesh.actionManager.registerAction(
          new BABYLON.ExecuteCodeAction(
            BABYLON.ActionManager.OnPickTrigger,
            () => {
              console.log('Hotspot clicked:', h.title);
              // Handle popup display based on activationMode
              if (h.activationMode === 'click') {
                trackHotspotInteraction(h.title, 'click'); // Assuming trackHotspotInteraction exists globally or is defined elsewhere
                if (isInAR) { // Assuming isInAR is defined globally
                  showARContent(h); // Assuming showARContent exists globally
                } else {
                  showHotspotContent(h); // Assuming showHotspotContent exists globally
                }
              }

              // Handle media playback/visibility based on mediaTriggerMode
              if (h.mediaTriggerMode === 'click') {
                if (h.type === 'video') {
                  const videoTexture = mesh.material?.getActiveTextures().find(tex => tex instanceof BABYLON.VideoTexture);
                  if (videoTexture?.video) {
                    if (videoTexture.video.paused) {
                      videoTexture.video.play().catch(e => console.error("Video play failed:", e));
                    } else {
                      videoTexture.video.pause();
                   }
                 }
               } else if (h.type === 'gif') {
                 // Toggle play/pause for AnimatedGifTexture on click
                 const gifTexture = mesh.material?.getActiveTextures().find(tex => tex instanceof AnimatedGifTexture);
                 if (gifTexture) {
                   if (gifTexture.isPlaying) {
                     gifTexture.pause();
                   } else {
                     gifTexture.play();
                   }
                 }
               }
             }
           }
          )
        );
      }
    }

    // Function to check if hotspot should be visible based on current scroll position
    function updateHotspotVisibility(hotspot, mesh, scrollPercentage, currentWaypointIndex) {
      if (!hotspot.visibilityRange) {
        mesh.setEnabled(true); // Default to visible if no range specified
        // Also enable the parent transform node
        if (mesh.parent) {
            mesh.parent.setEnabled(true);
        }
        return;
      }

      const { type, start, end } = hotspot.visibilityRange;
      let isVisible = false;
      if (type === 'percentage') {
        isVisible = scrollPercentage >= start && scrollPercentage <= end;
      } else if (type === 'waypoint') {
        isVisible = currentWaypointIndex >= start && currentWaypointIndex <= end;
      }

      // Enable/disable the mesh itself
      mesh.setEnabled(isVisible);

      // Enable/disable the parent transform node as well
      const transformNode = mesh.parent;
      if (transformNode) {
        transformNode.setEnabled(isVisible);
      }
    }

    // Register scene before render to update hotspot visibility
    scene.registerBeforeRender(() => {
      // Calculate current percentage and waypoint index
      const subdivisionsPerSegment = 20;
      let currentWaypointIndex = Math.round((scrollPosition / subdivisionsPerSegment) * 100) / 100; // Round to 2 decimal places for precision
      const scrollPercent = (scrollPosition / (path.length - 1 || 1)) * 100;

      // Try unmuting autoplay videos if interaction happened before render loop started
      // The call to unmuteAutoplayVideos() was removed from here as it's not tied to a specific
      // user gesture at this point and can cause "Unmuting failed" warnings.
      // It's still called once from handleFirstInteraction.

      hotspots.forEach((h) => {
        const mesh = scene.getMeshByName(`hotspot-${h.id}`);
        if (mesh) {
          const wasVisible = mesh.metadata?.wasVisible ?? mesh.isEnabled(); // Get previous state or current if first run
          updateHotspotVisibility(h, mesh, scrollPercent, currentWaypointIndex);
          const isVisible = mesh.isEnabled();

          // --- Scroll Trigger Play/Pause Logic ---
          if (h.type === 'video' && h.mediaTriggerMode === 'scroll') {
            const videoTexture = mesh.material?.getActiveTextures().find(tex => tex instanceof BABYLON.VideoTexture);
            if (videoTexture?.video) {
              if (isVisible && !wasVisible) { // Just became visible
                console.log(`Playing scroll-triggered video: ${h.title}`);
                videoTexture.video.play().catch(e => console.warn(`Scroll trigger play failed for ${h.title}:`, e));
              } else if (!isVisible && wasVisible) { // Just became hidden
                console.log(`Pausing scroll-triggered video: ${h.title}`);
                videoTexture.video.pause();
              }
            }
            // Update visibility state in metadata
            mesh.metadata = { ...mesh.metadata, wasVisible: isVisible };
          }
          // --- End Scroll Trigger Logic ---


          // Update the opacity of the mesh based on the opacityMode
          if (h.opacityMode === 'animated' && h.opacityAnimation) {
            const { startPercent, endPercent, startOpacity, endOpacity } = h.opacityAnimation;
            const animationRange = endPercent - startPercent;
            const currentRange = scrollPercent - startPercent;
            const currentOpacity = startOpacity + ((endOpacity - startOpacity) * (currentRange / animationRange));
            applyOpacityToMesh(mesh, currentOpacity);
          }
        }
      });
    });
    function showHotspotContent(hotspot) {
      if (isInAR) {
        showARContent(hotspot);
